MYSQL_IMAGE=portfolio26-mysql:local
GAMESERVER_IMAGE=portfolio26-gameserver:local
DUMMY_IMAGE=portfolio26-dummy:local
BUILD_PRESET=linux-Debug
NETLIB_ENABLE_OTEL=ON
NETLIB_ENABLE_TRACY=ON
VCPKG_CACHE_IMAGE=ghcr.io/pshpjr/gameserver:vcpkg-cache
MYSQL_PORT=3306
GAME_PORT=11333
TRACY_PORT=8086
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.163.2
PROMETHEUS_IMAGE=prom/prometheus:v3.15.1
GRAFANA_IMAGE=grafana/grafana:13.2.4
OTLP_HTTP_PORT=4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
